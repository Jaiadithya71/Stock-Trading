{
  "name": "trading-dashboard-backend",
  "version": "1.0.0",
  "description": "Bank Nifty Trading Dashboard Backend",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "sim:bullish": "node test/cliController.js bullish",
    "sim:bearish": "node test/cliController.js bearish",
    "sim:crash": "node test/cliController.js crash",
    "sim:whip": "node test/cliController.js whip",
    "sim:chop": "node test/cliController.js chop",
    "sim:reversal": "node test/cliController.js reversal",
